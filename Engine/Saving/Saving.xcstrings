    "LastUsed.Empty.Message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichere einmal mit „In Albums sichern“ oder „In Fotos sichern“. Danach sichert diese Aktion am selben Ort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save something with Save to Albums or Save to Photos first, and this will save to the same place."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Albumsに保存」または「写真に保存」で一度保存すると、次回から同じ場所に保存できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Albums에 저장’ 또는 ‘사진에 저장’으로 먼저 저장하면 다음부터 같은 위치에 저장됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先使用“存储到 Albums”或“存储到照片”存储一次，之后就会存储到同一位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先使用「儲存到 Albums」或「儲存到照片」儲存一次，之後就會儲存到同一位置。"
          }
        }
      }
    },

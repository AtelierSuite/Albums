    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID schützt Ihre Sammlung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Face ID to protect your collection."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コレクションを保護するためにFace IDを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID를 사용해 컬렉션을 보호합니다."

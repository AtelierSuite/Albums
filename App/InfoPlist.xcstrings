    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albums benötigt Zugriff auf deine Fotomediathek, um Bilder aus deinen Alben zu durchsuchen und zu importieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Albums needs access to your Photos library to browse and import images from your albums."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アルバム内の画像を閲覧・インポートするために、Albumsは写真ライブラリへのアクセスを必要とします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albums에서 앨범의 이미지를 탐색하고 가져오려면 사진 보관함 접근 권한이 필요합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albums 需要访问你的照片图库，以便浏览和导入相册中的图片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albums 需要存取你的照片圖庫，以便瀏覽和匯入相簿中的圖片。"
          }
        }
      }
    },

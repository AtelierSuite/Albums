    "NoProvenance.Description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildschirmfotos, erneutes Speichern und Uploads in soziale Medien entfernen Inhaltsnachweise oft. Fehlende Daten verraten also nicht, wie dies erstellt wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screenshots, re-saves, and social media uploads often remove Content Credentials, so missing data doesn't tell you how this was made."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンショットや再保存、SNSへのアップロードでコンテンツ認証情報は削除されることが多いため、データがなくても作成方法はわかりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크린샷, 다시 저장, 소셜 미디어 업로드 시 콘텐츠 자격 증명이 제거되는 경우가 많으므로 데이터가 없다고 해서 제작 방식을 알 수는 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "截屏、重新存储和上传到社交媒体通常会移除内容凭证，因此缺少数据并不能说明其制作方式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "截圖、重新儲存和上傳到社群媒體通常會移除內容憑證，因此缺少資料並不能說明其製作方式。"
          }
        }
      }
    },

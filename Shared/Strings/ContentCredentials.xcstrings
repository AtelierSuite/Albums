      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhaltsnachweise werden geprüft, sobald das Original geladen ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Content Credentials will be checked once the original is downloaded."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オリジナルがダウンロードされるとコンテンツ認証情報が確認されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원본이 다운로드되면 콘텐츠 자격 증명을 확인합니다."

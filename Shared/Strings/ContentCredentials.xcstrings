    "Found.Description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhaltsnachweise sind signierte Angaben, die von der App oder dem Gerät hinzugefügt wurden, mit dem diese Datei erstellt oder bearbeitet wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Content Credentials are signed details attached by the app or device that made or edited this file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテンツ認証情報は、このファイルを作成または編集したアプリやデバイスが付加した署名付きの情報です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "콘텐츠 자격 증명은 이 파일을 만들거나 편집한 앱 또는 기기가 첨부한 서명된 정보입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内容凭证是由创建或编辑此文件的 App 或设备附加的已签名信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "內容憑證是由建立或編輯此檔案的 App 或裝置附加的已簽署資訊。"
          }
        }
      }
    },

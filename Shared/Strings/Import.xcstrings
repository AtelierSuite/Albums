    "Import.Interrupted.Message.%lld" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Element wurde noch nicht importiert. Du kannst den Import fortsetzen oder ihn beenden und entscheiden, ob die bereits importierten Elemente behalten werden."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Elemente wurden noch nicht importiert. Du kannst den Import fortsetzen oder ihn beenden und entscheiden, ob die bereits importierten Elemente behalten werden."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld item has not been imported yet. You can resume the import, or stop it and choose whether to keep the pics that were already imported."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld items have not been imported yet. You can resume the import, or stop it and choose whether to keep the pics that were already imported."
                }
              }
            }
          }
        },
        "ja" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "まだインポートされていない項目が%lld件あります。インポートを再開するか、中止してすでにインポートされた項目を残すかどうかを選択できます。"
                }
              }
            }
          }
        },
        "ko" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "아직 가져오지 않은 항목이 %lld개 있습니다. 가져오기를 재개하거나, 중단하고 이미 가져온 항목을 유지할지 선택할 수 있습니다."

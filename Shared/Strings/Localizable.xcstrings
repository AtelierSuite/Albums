    "Move.DownloadAlert.Message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Bewegen in eine Bibliothek ohne iCloud werden alle Originale auf dieses Gerät geladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moving to a non-iCloud library will download all originals to this device."

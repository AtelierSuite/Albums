    "Shared.DeleteConfirmation.Album.Message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst nur das Album löschen und seine Inhalte in das übergeordnete Album verschieben oder das Album zusammen mit allen seinen Inhalten löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",

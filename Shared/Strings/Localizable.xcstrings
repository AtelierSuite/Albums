          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アルバムのみを削除して中身を親アルバムに移動するか、アルバムとそのすべての中身を削除するかを選べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앨범만 삭제하고 내용을 상위 앨범으로 이동하거나, 앨범과 모든 내용을 함께 삭제할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以仅删除相册并将其内容移至上级相册，或删除相册及其所有内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
